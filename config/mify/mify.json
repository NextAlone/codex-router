{
  "version": 1,
  "providers": [
    {
      "id": "mify",
      "displayName": "Mify Direct",
      "kind": "openai-compatible",
      "ownedBy": "mify",
      "baseUrl": "http://model.mify.ai.srv/v1",
      "baseUrlEnv": "MIFY_BASE_URL",
      "credential": {
        "environment": [
          "MIFY_API_KEY"
        ],
        "file": "mify-api-key.secret",
        "legacyFiles": [],
        "keychainServices": [
          "codex-router-mify-api"
        ],
        "prompt": "Mify API key"
      }
    }
  ]
}
